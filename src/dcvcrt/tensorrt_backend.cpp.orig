struct TensorSpec final {
    std::string_view name;
    nvinfer1::TensorIOMode mode;
    std::array<std::int64_t, 4> dimensions;
};

struct EngineSpec final {
    std::string_view filename;
    std::span<const TensorSpec> tensors;
};

