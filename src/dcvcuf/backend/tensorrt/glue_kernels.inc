        _z0 = max(_z0, static_cast<Half>(-64.f));
        _z1 = max(_z1, static_cast<Half>(-64.f));
        _z0 = min(_z0, static_cast<Half>(63.f));
        _z1 = min(_z1, static_cast<Half>(63.f));
        int8_t _z0_int8 = static_cast<int8_t>(_z0);
        int8_t _z1_int8 = static_cast<int8_t>(_z1);
        store2(&z_int8[n0], _z0_int8, _z1_int8);
        store2(&z_hat[n0], _z0, _z1);
    }
}

__global__ void single_part_for_reading_4x_kernel(GPUTensor4D<Half> out,
                                                  const GPUTensor4D<Half> x,
                                                  const GPUTensor4D<bool> mask, const CudaCHW chw)
{
