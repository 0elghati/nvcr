    const int c2 = c1 + chw.C;
    const int c3 = c2 + chw.C;
    const int c4 = c3 + chw.C;
    cudaGDC();

    if (c < chw.C && h < chw.H && w < chw.W) {
        Half _x1 = x[0][c1][h][w] * mask[0][c1][h][w];
        Half _x2 = x[0][c2][h][w] * mask[0][c2][h][w];
        Half _x3 = x[0][c3][h][w] * mask[0][c3][h][w];
        Half _x4 = x[0][c4][h][w] * mask[0][c4][h][w];
        out[0][c][h][w] = _x1 + _x2 + _x3 + _x4;
    }
}

