# Select a registered codec and use identities accepted by that adapter.
# DCVC-RT users should set codec_id=dcvc-rt and follow docs/dcvcrt-artifacts.md.
codec_id=example-codec
model_id=example-model
bitstream_model_id=example-stream
provider_id=example-provider
# Optional provider-owned artifact paths.
intra_engine_path=/opt/nvcr/models/example
predicted_engine_path=/opt/nvcr/models/example
entropy_model_path=/opt/nvcr/models/example
device_id=0
intra_qp=32
gop_size=32
memory_pool_bytes=268435456
device_arena_bytes=536870912
max_packet_bytes=67108864
log_level=info
tensorrt_execution_mode=automatic
allow_legacy_access_units=true
verify_encoder_reconstruction=false
enable_profiling=false
