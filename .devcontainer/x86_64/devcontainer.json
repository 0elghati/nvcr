{
  "name": "NVCR — RTX / x86_64",
  "build": {
    "context": "../..",
    "dockerfile": "../../docker/Dockerfile.x86_64",
    "target": "development"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "runArgs": ["--gpus=all"],
  "containerEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "NVIDIA_VISIBLE_DEVICES": "all"
  },
  "remoteUser": "nvcr",
  "updateRemoteUserUID": true,
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/nvcr,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/nvcr",
  "mounts": [
    "source=nvcr-x86-build,target=/workspace/nvcr/build-devcontainer,type=volume",
    "source=${localEnv:USERPROFILE}/.aws,target=/home/nvcr/.aws,type=bind,readonly"
  ],
  "postCreateCommand": "sudo mkdir -p \"$HOME/.aws\" && sudo chown -R nvcr:nvcr \"$HOME/.aws\" build-devcontainer && cmake -S . -B build-devcontainer -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CUDA_ARCHITECTURES=89 -DNVCR_ENABLE_TENSORRT=ON",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "nvidia.nsight-vscode-edition"
      ]
    }
  }
}
