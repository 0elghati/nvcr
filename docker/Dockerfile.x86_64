# syntax=docker/dockerfile:1.7

# The defaults reproduce the RTX 4070 reference image. Build arguments allow a
# discrete-GPU target to select CUDA architectures within the common 10.9 stack.
ARG CUDA_DEVEL_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
ARG TENSORRT_PACKAGE_VERSION=10.9.0.34-1+cuda12.8
ARG NVCR_CUDA_ARCHITECTURES=89
ARG NVCR_TARGET_PROFILE=rtx4070-ubuntu2404
ARG NVCR_CUDA_VERSION=12.8
ARG NVCR_TENSORRT_VERSION=10.9
ARG NVCR_IMAGE_DESCRIPTION="NVCR runtime for linux/amd64 NVIDIA discrete GPUs; default reference is RTX 4070 SM 8.9"

FROM ${CUDA_DEVEL_IMAGE} AS toolchain

ARG DEBIAN_FRONTEND=noninteractive
ARG TENSORRT_PACKAGE_VERSION
ARG NVCR_CUDA_ARCHITECTURES
ARG NVCR_TARGET_PROFILE

RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        gdb \
        git \
        ninja-build \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        shellcheck \
        sudo \
    && apt-get install -y --no-install-recommends \
        "libnvinfer-headers-dev=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer-bin=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer-dispatch10=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer-lean10=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer-plugin10=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer-vc-plugin10=${TENSORRT_PACKAGE_VERSION}" \
        "libnvinfer10=${TENSORRT_PACKAGE_VERSION}" \
        "libnvonnxparsers10=${TENSORRT_PACKAGE_VERSION}" \
    && tensorrt_soname="$(find /usr/lib/x86_64-linux-gnu -maxdepth 1 -name 'libnvinfer.so.*' -print | sort -V | tail -n1)" \
    && test -n "${tensorrt_soname}" \
    && ln -sf "${tensorrt_soname}" /usr/local/lib/libnvinfer.so \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    NVCR_CONTAINER_ARCH=x86_64 \
    NVCR_CUDA_ARCHITECTURES=${NVCR_CUDA_ARCHITECTURES} \
    NVCR_TARGET_PROFILE=${NVCR_TARGET_PROFILE}

FROM toolchain AS development

ARG USERNAME=nvcr
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    existing_group="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "${USERNAME}" ]; then \
        groupmod --new-name "${USERNAME}" "${existing_group}"; \
    elif [ -z "${existing_group}" ]; then \
        groupadd --gid "${USER_GID}" "${USERNAME}"; \
    fi; \
    existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "${USERNAME}" ]; then \
        usermod --login "${USERNAME}" --home "/home/${USERNAME}" --move-home "${existing_user}"; \
    elif [ -z "${existing_user}" ]; then \
        useradd --uid "${USER_UID}" --gid "${USERNAME}" --create-home --shell /bin/bash "${USERNAME}"; \
    fi; \
    usermod --gid "${USERNAME}" --append --groups sudo "${USERNAME}"; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace/nvcr; \
    chown "${USERNAME}:${USERNAME}" /workspace/nvcr

USER ${USERNAME}
WORKDIR /workspace/nvcr
CMD ["/bin/bash"]

FROM toolchain AS test

COPY . /workspace/nvcr
COPY --chmod=0755 docker/test.sh /usr/local/bin/nvcr-test

WORKDIR /workspace/nvcr
ENTRYPOINT ["/usr/local/bin/nvcr-test"]
CMD ["gpu"]

FROM toolchain AS build

ARG NVCR_CUDA_ARCHITECTURES

COPY . /src

RUN cmake -S /src -B /tmp/nvcr-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        "-DCMAKE_CUDA_ARCHITECTURES=${NVCR_CUDA_ARCHITECTURES}" \
        -DCMAKE_INSTALL_PREFIX=/opt/nvcr \
        -DNVCR_BUILD_TESTS=OFF \
        -DNVCR_ENABLE_TENSORRT=ON \
    && cmake --build /tmp/nvcr-build --parallel \
    && cmake --install /tmp/nvcr-build

FROM ${CUDA_RUNTIME_IMAGE} AS runtime

ARG NVCR_VERSION=0.5.1
ARG NVCR_REVISION=unknown
ARG NVCR_SOURCE=https://github.com/0elghati/nvcr
ARG NVCR_CREATED=1970-01-01T00:00:00Z
ARG DEBIAN_FRONTEND=noninteractive
ARG NVCR_CUDA_ARCHITECTURES
ARG NVCR_TARGET_PROFILE
ARG NVCR_CUDA_VERSION
ARG NVCR_TENSORRT_VERSION
ARG NVCR_IMAGE_DESCRIPTION

RUN sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/nvcr /opt/nvcr
COPY --from=toolchain /usr/lib/x86_64-linux-gnu/libnvinfer.so.10* /usr/lib/x86_64-linux-gnu/

RUN ldconfig

LABEL org.opencontainers.image.title="NVCR RTX execution image" \
      org.opencontainers.image.description="${NVCR_IMAGE_DESCRIPTION}" \
      org.opencontainers.image.version="${NVCR_VERSION}" \
      org.opencontainers.image.revision="${NVCR_REVISION}" \
      org.opencontainers.image.source="${NVCR_SOURCE}" \
      org.opencontainers.image.created="${NVCR_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      io.nvcr.target-profile="${NVCR_TARGET_PROFILE}" \
      io.nvcr.cuda-version="${NVCR_CUDA_VERSION}" \
      io.nvcr.tensorrt-version="${NVCR_TENSORRT_VERSION}" \
      io.nvcr.cuda-architectures="${NVCR_CUDA_ARCHITECTURES}"

ENV PATH=/opt/nvcr/bin:${PATH} \
    NVCR_CONTAINER_ARCH=x86_64 \
    NVCR_CUDA_ARCHITECTURES=${NVCR_CUDA_ARCHITECTURES} \
    NVCR_TARGET_PROFILE=${NVCR_TARGET_PROFILE} \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all

WORKDIR /work
ENTRYPOINT ["/opt/nvcr/bin/nvcr"]
CMD ["--help"]
