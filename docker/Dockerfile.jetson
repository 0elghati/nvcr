# syntax=docker/dockerfile:1.7

# Jetson images must be built on an aarch64 Jetson host. The official JetPack
# 6.1 image provides the CUDA 12.6 / TensorRT 10.3 userspace used by the Orin
# profile; the host remains responsible for the L4T driver and device stack.
ARG L4T_JETPACK_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0@sha256:34ccf0f3b63c6da9eee45f2e79de9bf7fdf3beda9abfd72bbf285ae9d40bb673
ARG NVCR_JETSON_PLATFORM=linux/arm64

FROM --platform=${NVCR_JETSON_PLATFORM} ${L4T_JETPACK_IMAGE} AS toolchain

ARG DEBIAN_FRONTEND=noninteractive
ARG CMAKE_VERSION=3.31.6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        gdb \
        git \
        ninja-build \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        shellcheck \
        sudo \
    && python3 -m pip install --no-cache-dir "cmake==${CMAKE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    NVCR_CONTAINER_ARCH=aarch64 \
    NVCR_TARGET_PROFILE=orin-nano-l4t3647

FROM toolchain AS development

ARG USERNAME=nvcr
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    existing_group="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_group}" ] && [ "${existing_group}" != "${USERNAME}" ]; then \
        groupmod --new-name "${USERNAME}" "${existing_group}"; \
    elif [ -z "${existing_group}" ]; then \
        groupadd --gid "${USER_GID}" "${USERNAME}"; \
    fi; \
    existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)"; \
    if [ -n "${existing_user}" ] && [ "${existing_user}" != "${USERNAME}" ]; then \
        usermod --login "${USERNAME}" --home "/home/${USERNAME}" --move-home "${existing_user}"; \
    elif [ -z "${existing_user}" ]; then \
        useradd --uid "${USER_UID}" --gid "${USERNAME}" --create-home --shell /bin/bash "${USERNAME}"; \
    fi; \
    usermod --gid "${USERNAME}" --append --groups sudo "${USERNAME}"; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace/nvcr; \
    chown "${USERNAME}:${USERNAME}" /workspace/nvcr

USER ${USERNAME}
WORKDIR /workspace/nvcr
CMD ["/bin/bash"]

FROM toolchain AS test

COPY . /workspace/nvcr
COPY --chmod=0755 docker/test.sh /usr/local/bin/nvcr-test

ENV NVCR_CUDA_ARCHITECTURES=87

WORKDIR /workspace/nvcr
ENTRYPOINT ["/usr/local/bin/nvcr-test"]
CMD ["gpu"]

FROM toolchain AS build

COPY . /src

# The JetPack TensorRT DSOs retain DLA/CUDLA references that the NVIDIA
# container runtime satisfies from the host driver stack. Docker build stages
# do not run with that injection, so permit unresolved symbols in dependent
# shared libraries while still requiring NVCR's own link symbols to resolve.
RUN test "$(uname -m)" = aarch64 \
    && cmake -S /src -B /tmp/nvcr-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=87 \
        -DCMAKE_EXE_LINKER_FLAGS="-Wl,--allow-shlib-undefined" \
        -DCMAKE_INSTALL_PREFIX=/opt/nvcr \
        -DNVCR_BUILD_TESTS=OFF \
        -DNVCR_ENABLE_TENSORRT=ON \
    && cmake --build /tmp/nvcr-build --parallel \
    && cmake --install /tmp/nvcr-build

FROM --platform=${NVCR_JETSON_PLATFORM} ${L4T_JETPACK_IMAGE} AS runtime

ARG NVCR_VERSION=0.5.1
ARG NVCR_REVISION=unknown
ARG NVCR_SOURCE=https://github.com/0elghati/nvcr
ARG NVCR_CREATED=1970-01-01T00:00:00Z
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/nvcr /opt/nvcr

LABEL org.opencontainers.image.title="NVCR Jetson execution image" \
      org.opencontainers.image.description="NVCR runtime for linux/arm64 Jetson Orin; default reference is Orin Nano SM 8.7" \
      org.opencontainers.image.version="${NVCR_VERSION}" \
      org.opencontainers.image.revision="${NVCR_REVISION}" \
      org.opencontainers.image.source="${NVCR_SOURCE}" \
      org.opencontainers.image.created="${NVCR_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      io.nvcr.target-profile="orin-nano-l4t3647" \
      io.nvcr.jetpack-version="6.1" \
      io.nvcr.l4t-version="36.4" \
      io.nvcr.cuda-version="12.6" \
      io.nvcr.tensorrt-version="10.3" \
      io.nvcr.cuda-architectures="87"

ENV PATH=/opt/nvcr/bin:${PATH} \
    NVCR_CONTAINER_ARCH=aarch64 \
    NVCR_TARGET_PROFILE=orin-nano-l4t3647 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    NVIDIA_VISIBLE_DEVICES=all

WORKDIR /work
ENTRYPOINT ["/opt/nvcr/bin/nvcr"]
CMD ["--help"]
